{
  "name": "attach_history",
  "description": "Record history the patient tells you (allergies, medications, conditions) on THIS patient's intake. It is stored as patient-reported and unverified.",
  "parameters": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "ALLERGY",
                "MEDICATION",
                "CONDITION",
                "OTHER"
              ]
            },
            "text": {
              "type": "string",
              "maxLength": 200
            },
            "evidenceQuote": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "kind",
            "text",
            "evidenceQuote"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "items"
    ],
    "additionalProperties": false
  }
}
