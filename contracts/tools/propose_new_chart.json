{
  "name": "propose_new_chart",
  "description": "Ask to register this person as a NEW patient. The front-desk policy decides; you may be told a registrar must review first. Never tell the patient a chart was created unless the result says NEW_CHART_CREATED.",
  "parameters": {
    "type": "object",
    "properties": {
      "givenName": {
        "type": "string",
        "maxLength": 60
      },
      "familyName": {
        "type": "string",
        "maxLength": 80,
        "description": "All surnames exactly as the patient said them, e.g. 'González Rivera'."
      },
      "birthDate": {
        "type": "string",
        "description": "ISO 8601 date, YYYY-MM-DD."
      },
      "sex": {
        "type": "string",
        "enum": [
          "FEMALE",
          "MALE",
          "UNKNOWN"
        ]
      },
      "phone": {
        "type": "string",
        "maxLength": 20
      },
      "addressLine": {
        "type": "string",
        "maxLength": 120
      },
      "postalCode": {
        "type": "string",
        "pattern": "^[0-9]{5}$"
      },
      "preferredLanguage": {
        "type": "string",
        "enum": [
          "ES",
          "EN"
        ]
      },
      "evidence": {
        "type": "object",
        "description": "For every demographic field you fill, the exact words the patient typed that support it, copied verbatim.",
        "properties": {
          "givenName": {
            "type": "string",
            "maxLength": 160
          },
          "familyName": {
            "type": "string",
            "maxLength": 160
          },
          "birthDate": {
            "type": "string",
            "maxLength": 160
          },
          "sex": {
            "type": "string",
            "maxLength": 160
          },
          "phone": {
            "type": "string",
            "maxLength": 160
          },
          "addressLine": {
            "type": "string",
            "maxLength": 160
          },
          "postalCode": {
            "type": "string",
            "maxLength": 160
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "givenName",
      "familyName",
      "birthDate",
      "sex",
      "preferredLanguage",
      "evidence"
    ],
    "additionalProperties": false
  }
}
